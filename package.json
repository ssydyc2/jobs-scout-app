{
  "name": "jobs-scout-app",
  "version": "0.1.0",
  "description": "A personal macOS company scout powered by GLM",
  "private": true,
  "main": "out/main/index.js",
  "author": "Jobs Scout",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "icon": "npm run build && node scripts/make-icon.mjs",
    "package:mac": "npm run build && electron-builder --mac zip --arm64",
    "package:dir": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.jobsscout.app",
    "productName": "Jobs Scout",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "examples/scout.json", "to": "scout.json" }],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": ["zip"],
      "identity": null,
      "darkModeSupport": true
    }
  }
}
